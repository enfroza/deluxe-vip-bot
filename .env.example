# ==========================================================
#  DELUXE VIP — Environment Configuration
#  Copy this file to ".env" and fill in real values.
#  NEVER commit your real .env file to version control.
# ==========================================================

# Token from @BotFather (Bot -> API Token)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# The target private channel the bot sells access to.
# Use the numeric chat id (e.g. -1001234567890). The bot account
# MUST be an admin of this channel with "Invite Users via Link" rights.
CHANNEL_ID=-1001234567890

# Optional, human-readable label shown in the WebApp
CHANNEL_NAME=DELUXE VIP

# Comma-separated list of Telegram numeric user IDs allowed into the admin panel
ADMIN_IDS=111111111,222222222

# Default access price in Telegram Stars (whole integer, 1 Star = smallest unit for XTR)
DEFAULT_PRICE_STARS=499

# Public HTTPS base URL where this app is deployed (needed for the WebApp button + webhook)
PUBLIC_URL=https://your-domain.example.com

# Port the Express server listens on
PORT=3000

# Optional: set a fixed webhook secret token (Telegram will echo this back on every webhook call)
WEBHOOK_SECRET=change_me_to_a_random_string

# SQLite database file path
DATABASE_PATH=./data/deluxevip.sqlite
